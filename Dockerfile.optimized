FROM node:18-slim as server

WORKDIR /app

RUN apt update && apt -y install g++ make python3

COPY ./server/package*.json ./
COPY ./server/yarn.lock ./

RUN yarn config set registry https://registry.npmjs.org/
RUN yarn config set network-timeout 1200000
RUN yarn install --frozen-lockfile

COPY ./server/ .
RUN yarn build

FROM node:18-slim as build
WORKDIR /app

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_HOST_URL
ENV VITE_HOST_URL=$VITE_HOST_URL
ARG VITE_GOOGLE_OAUTH_CLIENT_ID
ENV VITE_GOOGLE_OAUTH_CLIENT_ID=$VITE_GOOGLE_OAUTH_CLIENT_ID
ARG VITE_GOOGLE_OAUTH_CLIENT_REDIRECT_URL
ENV VITE_GOOGLE_OAUTH_CLIENT_REDIRECT_URL=$VITE_GOOGLE_OAUTH_CLIENT_REDIRECT_URL

RUN apt update
RUN npm --no-update-notifier --no-fund --global install pnpm

# Copy package files first for better caching
COPY package*.json pnpm-workspace.yaml ./
COPY app/ui/package*.json ./app/ui/
COPY app/widget/package*.json ./app/widget/
COPY app/script/package*.json ./app/script/

RUN pnpm install

# Copy source code
COPY . .

# Install dev dependencies for build
RUN pnpm install --dev

# Build only UI and widget, skip script for now
RUN pnpm --filter ui build
RUN pnpm --filter widget build

FROM node:18-slim
WORKDIR /app

RUN yarn config set registry https://registry.npmjs.org/
RUN yarn config set network-timeout 1200000

RUN apt update && apt -y install --no-install-recommends ca-certificates git git-lfs openssh-client curl jq cmake sqlite3 openssl psmisc python3
RUN apt -y install g++ make
RUN apt-get clean autoclean && apt-get autoremove --yes && rm -rf /var/lib/{apt,dpkg,cache,log}/
RUN npm --no-update-notifier --no-fund --global install pnpm

# Copy API
COPY --from=server /app/dist/ .
COPY --from=server /app/prisma/ ./prisma
COPY --from=server /app/package.json .

# Copy UI
COPY --from=build /app/app/ui/dist/ ./public

# Copy widgets 
COPY --from=build /app/app/widget/dist/assets/ ./public/assets
COPY --from=build /app/app/widget/dist/index.html ./public/bot.html

# Copy script
COPY --from=build /app/app/script/dist/chat.min.js ./public/chat.min.js

RUN yarn install --production --frozen-lockfile

ENV NODE_ENV=production

EXPOSE 3000

CMD ["yarn", "start"] 